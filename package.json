{
  "name": "ca",
  "version": "1.2.16",
  "private": true,
  "workspaces": [
    "cabuildtools"
  ],
  "engines": {
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "node ./cabuildtools/main.mjs buildRelease",
    "snapshot": "node ./cabuildtools/main.mjs buildSnapshot",
    "postinstall": "node scripts/check-legacy.mjs",
    "gradlew": "node ./cabuildtools/cli/gradlew.mjs",
    "help": "node ./cabuildtools/main.mjs help",
    "pack": "node ./cabuildtools/cli/libtool.mjs pack",
    "unpack": "node ./cabuildtools/cli/libtool.mjs unpack",
    "info": "node ./cabuildtools/cli/libtool.mjs info",
    "caaccel": "node ./cabuildtools/main.mjs caaccel",
    "test": "node ./cabuildtools/tests/async-transform.test.mjs && node ./cabuildtools/tests/loader-ast.test.mjs",
    "update": "node ./cabuildtools/cli/deps.mjs check",
    "upgrade": "node ./cabuildtools/cli/deps.mjs update",
    "publishRelease": "node ./cabuildtools/main.mjs publishRelease",
    "publishSnapshot": "node ./cabuildtools/main.mjs publishSnapshot",
    "publishHotfix": "node ./cabuildtools/main.mjs publishHotfix",
    "publishCLib": "node ./cabuildtools/main.mjs publishCLib",
    "kotlin:js": "node ./scripts/build-kotlin-js.mjs",
    "pretest": "node ./scripts/build-kotlin-js.mjs"
  }
}
