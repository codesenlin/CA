{
  "name": "ca",
  "version": "1.2.16",
  "private": true,
  "workspaces": [
    "cabuildtools"
  ],
  "engines": {
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "node ./cabuildtools/main.js buildRelease",
    "snapshot": "node ./cabuildtools/main.js buildSnapshot",
    "postinstall": "node scripts/check-legacy.js",
    "gradlew": "node ./cabuildtools/gradlew.js",
    "help": "node ./cabuildtools/main.js help",
    "pack": "node ./cabuildtools/libtool.js pack",
    "unpack": "node ./cabuildtools/libtool.js unpack",
    "info": "node ./cabuildtools/libtool.js info",
    "caaccel": "node ./caaccel/cli.js build",
    "caaccel:test": "node ./caaccel/cli.js test",
    "caaccel:bench": "node ./caaccel/cli.js bench",
    "test": "node ./cabuildtools/tests/async-transform.test.js && node ./cabuildtools/tests/loader-ast.test.js",
    "update": "node ./cabuildtools/deps.js check",
    "upgrade": "node ./cabuildtools/deps.js update",
    "kotlin:js": "node ./scripts/build-kotlin-js.js",
    "pretest": "node ./scripts/build-kotlin-js.js"
  }
}
